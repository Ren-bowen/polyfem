     Eigen::SparseMatrix<double> sparse_identity(int rows, int cols);
 
+    inline Eigen::VectorXd safe_sparse_matrix_vector_product(
+        const StiffnessMatrix &matrix, const Eigen::VectorXd &vector)
+    {
+        Eigen::VectorXd result = Eigen::VectorXd::Zero(matrix.rows());
+        for (Eigen::Index col = 0; col < matrix.outerSize(); ++col)
+        {
+            for (StiffnessMatrix::InnerIterator it(matrix, col); it; ++it)
+                result(it.row()) += it.value() * vector(col);
+        }
+        return result;
+    }
